# DashScope API 密钥（通义千问）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# 模型名称
# 可选值：qwen3.5-flash, qwen-turbo, qwen-max, qwen-max-longcontext
DASHSCOPE_MODEL=qwen3.5-flash

# 数据库连接配置
DB_TYPE=MySQL
DB_HOST=192.168.10.100
DB_PORT=3306
DB_USERNAME=test
DB_PASSWORD=test123
DB_NAME=youxiang
